TZ=Asia/Bangkok
PORT=3333
HOST=0.0.0.0
LOG_LEVEL=info

# กุญแจเข้ารหัส — สร้างด้วย: docker compose run --rm web node ace generate:key
#
# ใช้เข้ารหัสรหัสผ่าน HOSxP และ secret ของ MOPH ก่อนเก็บลงฐาน
# ตั้งครั้งเดียวแล้วห้ามเปลี่ยน ไม่งั้นค่าที่เข้ารหัสไว้เดิมจะถอดไม่ออก ต้องกรอกใหม่ทุกหน้า
# ห้ามใช้ค่าเดียวกับโรงพยาบาลอื่น และต้องสำรองเก็บไว้คู่กับ backup ฐานข้อมูล
APP_KEY=

# ค่านี้ใช้เฉพาะตอนพัฒนา — compose.prod.yml บังคับเป็น production ให้เองอยู่แล้ว
# ไม่ว่าบรรทัดนี้จะเขียนอะไร จึงไม่ต้องแก้ตอนติดตั้งใช้จริง
NODE_ENV=development
SESSION_DRIVER=cookie

# ส่ง cookie เฉพาะเมื่อเข้าผ่าน https เท่านั้นหรือไม่
# ปล่อยเป็น false ถ้าเปิดหน้าเว็บผ่าน http://<ไอพี>:3333 บนวงแลนตามปกติ
# ตั้ง true เมื่อมี HTTPS อยู่หน้าระบบแล้วเท่านั้น ไม่งั้นจะล็อกอินไม่ได้เลย
COOKIE_SECURE=false

# ฐานข้อมูลของแอปเราเอง (MariaDB container) — ไม่ใช่ HOSxP
# ค่าเชื่อมต่อ HOSxP และ MOPH กรอกผ่านหน้าเว็บ /settings ไม่ได้อยู่ที่นี่
DB_HOST=db
DB_PORT=3306
DB_USER=queuewnk
DB_DATABASE=queuewnk

# ⚠️ ตั้งรหัสผ่านเองก่อนเปิดใช้จริง อย่าใช้ค่าตัวอย่าง
# compose.prod.yml จะไม่ยอมสตาร์ตถ้าสองบรรทัดนี้ว่าง
DB_PASSWORD=เปลี่ยนรหัสนี้
DB_ROOT_PASSWORD=เปลี่ยนรหัสนี้ด้วย

# image ที่จะใช้ตอนรันด้วย compose.prod.yml
# เว้นว่างไว้ = ใช้ค่าตั้งต้นที่เขียนไว้ในไฟล์นั้น
# QUEUEWNK_IMAGE=ghcr.io/OWNER/queuewnk:0.1.0

# พอร์ตที่เปิดให้เข้าหน้าเว็บ เปลี่ยนถ้าเครื่องนั้นมีอย่างอื่นใช้ 3333 อยู่แล้ว
WEB_PORT=3333

# พอร์ตที่เปิดให้ต่อฐานข้อมูลของแอปจากเครื่องตัวเอง (เช่นด้วย HeidiSQL)
# ใช้เฉพาะตอนพัฒนา และผูกกับ 127.0.0.1 เสมอ ไม่ได้เปิดออกวง LAN
DB_PORT_HOST=3307
