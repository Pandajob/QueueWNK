TZ=Asia/Bangkok
PORT=3333
HOST=0.0.0.0
LOG_LEVEL=info

# สร้างด้วย: node ace generate:key
APP_KEY=

NODE_ENV=development
SESSION_DRIVER=cookie

# ฐานข้อมูลของแอปเราเอง (MariaDB container) — ไม่ใช่ HOSxP
# ค่าเชื่อมต่อ HOSxP และ MOPH Alert กรอกผ่านหน้าเว็บ /settings ไม่ได้อยู่ที่นี่
DB_HOST=db
DB_PORT=3306
DB_USER=queuewnk
DB_PASSWORD=queuewnk
DB_DATABASE=queuewnk
