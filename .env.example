# =====================================================================
#  กรอก 2 บรรทัดนี้เท่านั้น ที่เหลือปล่อยไว้ได้เลย
# =====================================================================

# 1) กุญแจเข้ารหัส — รันคำสั่งนี้แล้วเอาค่าที่ได้มาวางต่อท้าย =
#
#      docker compose run --rm --no-deps web node ace generate:key
#
#    ใช้เข้ารหัสรหัสผ่าน HOSxP และ secret ของ MOPH ก่อนเก็บลงฐาน
#    ตั้งครั้งเดียวแล้วห้ามเปลี่ยน ไม่งั้นค่าที่เข้ารหัสไว้เดิมจะถอดไม่ออก
#    ห้ามใช้ค่าเดียวกับที่อื่น และต้องสำรองเก็บคู่กับ backup ฐานข้อมูล
APP_KEY=

# 2) รหัสผ่านฐานข้อมูลของแอป — ตั้งเองอะไรก็ได้ ไม่ต้องจำ ระบบใช้เอง
#    (ไม่ใช่รหัสของ HOSxP — ตัวนั้นกรอกผ่านหน้าเว็บทีหลัง)
#    ระบบจะไม่ยอมสตาร์ตถ้าปล่อยว่างไว้
DB_PASSWORD=

# =====================================================================
#  ข้างล่างไม่ต้องแก้ นอกจากมีเหตุผลเฉพาะ
# =====================================================================

TZ=Asia/Bangkok
PORT=3333
HOST=0.0.0.0
LOG_LEVEL=info
SESSION_DRIVER=cookie

# ใช้เฉพาะตอนพัฒนา — ตอนติดตั้งจริง compose บังคับเป็น production ให้เองอยู่แล้ว
NODE_ENV=development

# พอร์ตที่เปิดให้เข้าหน้าเว็บ เปลี่ยนถ้าเครื่องนั้นมีอย่างอื่นใช้ 3333 อยู่
WEB_PORT=3333

# ฐานข้อมูลของแอปเราเอง ไม่ใช่ HOSxP
# ค่าเชื่อมต่อ HOSxP และ MOPH กรอกผ่านหน้าเว็บ ไม่ได้อยู่ในไฟล์นี้
DB_HOST=db
DB_PORT=3306
DB_USER=queuewnk
DB_DATABASE=queuewnk

# ส่ง cookie เฉพาะเมื่อเข้าผ่าน https เท่านั้นหรือไม่
# ปล่อย false ถ้าเปิดหน้าเว็บผ่าน http://<ไอพี>:3333 ตามปกติ
# ตั้ง true ต่อเมื่อมี HTTPS อยู่หน้าระบบแล้ว ไม่งั้นจะล็อกอินไม่ได้เลย
COOKIE_SECURE=false

# ใช้ image ตัวอื่นแทนตัวที่ docker load เข้ามา เช่นดึงจาก registry
# QUEUEWNK_IMAGE=ghcr.io/pandajob/queuewnk:0.1.0

# พอร์ตที่เปิดให้ต่อฐานข้อมูลของแอปจากเครื่องตัวเอง ใช้เฉพาะตอนพัฒนา
DB_PORT_HOST=3307
