# ค่าสมมติสำหรับรันเทสต์เท่านั้น — ไม่ใช่ความลับ และไม่ได้ใช้กับของจริง
#
# มีไฟล์นี้เพราะแอปตรวจ env ตั้งแต่ตอนบูต ถ้าไม่มีจะล้มก่อนเทสต์แรกจะได้รัน
# ทั้งบน CI และบนเครื่องคนที่เพิ่ง clone มาแล้วยังไม่ได้สร้าง .env
#
# เทสต์ทั้งหมดเป็น unit ล้วน ไม่ต่อฐานข้อมูลและไม่ยิงออกเน็ต
# ค่า DB ข้างล่างจึงไม่เคยถูกใช้เชื่อมต่อจริง

NODE_ENV=test
PORT=3333
HOST=0.0.0.0
LOG_LEVEL=silent
APP_KEY=testtesttesttesttesttesttesttest
SESSION_DRIVER=memory
COOKIE_SECURE=false

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=test
DB_PASSWORD=test
DB_DATABASE=test
