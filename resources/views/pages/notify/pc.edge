@component('layouts/main', { title: 'แจ้งเตือนประคับประคอง', active: 'nt-pc' })

  <h1>แจ้งเตือนผู้ป่วยประคับประคอง</h1>
  <p class="subtitle">
    อ่านรหัสวินิจฉัยจาก HOSxP (<code>ovstdiag</code> และ <code>iptdiag</code>)
