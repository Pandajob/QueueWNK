  {{--
    รับทราบผู้ป่วยเดิมก่อน ไม่งั้นรอบแรกจะยิงผู้ป่วยทั้งฐานออกกลุ่มทีเดียว
    วางไว้บนสุดเพราะเป็นสิ่งที่ต้องทำก่อนอย่างอื่นจะทำงาน
  --}}
  @if (!settings.seeded)
    <div class="panel notice">
      <div class="template-head">
        <h2 class="panel-title">ต้องรับทราบผู้ป่วยเดิมก่อน</h2>
        <span class="pill off">ยังไม่ได้ทำ</span>
      </div>
      <p class="hint">
        โรคกลุ่มนี้เป็นโรคเรื้อรัง ในฐานข้อมูลมีผู้ป่วยที่เข้าเกณฑ์อยู่แล้ว
        <strong id="seed-count">กำลังนับ…</strong>
        ถ้าเปิดใช้งานเลยโดยไม่รับทราบก่อน รอบแรกจะแจ้งทั้งหมดออกกลุ่มทีเดียว
        <br />
        การรับทราบคือบันทึกรายเดิมไว้ว่า<strong>เคยเห็นแล้ว</strong>
        โดย<strong>ไม่ส่งข้อความออกไปไหน</strong> หลังจากนั้นระบบจะแจ้งเฉพาะรายใหม่
      </p>
      <form method="POST" action="{{ route('notify.pc.seed') }}" style="margin-top: 14px">
        {{ csrfField() }}
        <button type="submit" class="primary">
          รับทราบผู้ป่วยเดิมทั้งหมด (ไม่ส่งแจ้งเตือน)
        </button>
      </form>
    </div>
  @end

  <div class="panel {{ settings.isEnabled ? '' : 'notice' }}">
    <div class="template-head">
      <h2 class="panel-title">สถานะ</h2>
      @if (settings.isEnabled && settings.groupId && settings.seeded)
        <span class="pill on">เปิดอยู่</span>
      @else
        <span class="pill off">ปิดอยู่</span>
      @end
    </div>

    <p class="hint">
      @if (settings.notifyImmediate)
        <strong>แจ้งทันที</strong> — เจอผู้ป่วยรายใหม่แล้วส่งภายในราว 1 นาที
      @end
      @if (settings.notifyImmediate && settings.notifyDaily)
        <br />
      @end
      @if (settings.notifyDaily)
        <strong>สรุปรายวัน</strong> — รวมรายใหม่ของวันส่งเวลา {{ settings.sendAt }} น.
      @end
      @if (!settings.notifyImmediate && !settings.notifyDaily)
        ยังไม่ได้เลือกโหมดแจ้งเตือน — เปิดอย่างน้อยหนึ่งอย่างด้านล่าง
      @end
