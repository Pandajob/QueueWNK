        · รับทราบรายเดิมเมื่อ
        {{ settings.seededAt.setZone('Asia/Bangkok').toFormat('dd/MM/yyyy HH:mm') }} น.
      @end
    </p>

    @if (settings.lastRunNote)
      <p class="hint" style="margin-top: 8px">
        รอบล่าสุด: {{ settings.lastRunNote }}
