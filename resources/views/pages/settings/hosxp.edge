@component('layouts/main', { title: 'ตั้งค่าฐานข้อมูล HOSxP', active: 'hosxp' })
  <h1>ฐานข้อมูล HOSxP</h1>
  <p class="subtitle">
    ระบบอ่านข้อมูลคิวจาก HOSxP อย่างเดียว ไม่เขียนกลับไปแม้แต่แถวเดียว
    แนะนำให้ใช้ user ที่มีสิทธิ์ <code>SELECT</code> เท่านั้น
  </p>

  <form method="POST" action="{{ route('settings.hosxp.save') }}" id="hosxp-form">
    {{ csrfField() }}

    <div class="panel">
      <div class="field">
        <label for="label">ชื่อเรียก</label>
        <input type="text" id="label" name="label"
               value="{{ old('label', connection?.label ?? 'HOSxP') }}" required />
      </div>

      <div class="row">
        <div class="field">
          <label for="host">Host</label>
          <input type="text" id="host" name="host"
                 value="{{ old('host', connection?.host ?? '') }}"
                 placeholder="IP หรือชื่อเครื่องฐานข้อมูล HOSxP" required />
        </div>
        <div class="field narrow">
          <label for="port">Port</label>
          <input type="number" id="port" name="port"
                 value="{{ old('port', connection?.port ?? 3306) }}" required />
        </div>
      </div>

      <div class="row">
        <div class="field">
          <label for="database">Database</label>
          <input type="text" id="database" name="database"
                 value="{{ old('database', connection?.database ?? 'hos') }}" required />
        </div>
        <div class="field">
          <label for="charset">Charset</label>
          <select id="charset" name="charset">
            @each (cs in charsets)
              <option value="{{ cs }}" {{ (old('charset', connection?.charset ?? 'tis620')) === cs ? 'selected' : '' }}>
                {{ cs }}
              </option>
            @end
          </select>
          <p class="hint">HOSxP v3 ส่วนใหญ่เป็น tis620</p>
        </div>
      </div>

      <div class="row">
        <div class="field">
          <label for="username">Username</label>
          <input type="text" id="username" name="username"
                 value="{{ old('username', connection?.username ?? '') }}" required autocomplete="off" />
        </div>
        <div class="field">
          <label for="password">Password</label>
          <input type="password" id="password" name="password"
                 placeholder="{{ connection ? '••••••••  (เว้นว่าง = ไม่เปลี่ยน)' : '' }}"
                 autocomplete="new-password" />
          <p class="hint">เก็บแบบเข้ารหัสด้วย APP_KEY และไม่แสดงกลับมาอีก</p>
        </div>
      </div>

      <div class="actions">
        <button type="submit" class="primary">บันทึก</button>
        <button type="button" class="secondary" id="test-btn"
                data-url="{{ route('settings.hosxp.test') }}">
          ทดสอบการเชื่อมต่อ
        </button>
      </div>

      @if (connection?.lastTestedAt)
        <p class="status-line">
          ทดสอบล่าสุด {{ connection.lastTestedAt.setZone('Asia/Bangkok').toFormat('dd/MM/yyyy HH:mm') }} —
          {{ connection.lastTestOk ? 'ผ่าน' : 'ไม่ผ่าน' }}
        </p>
      @end

      <div class="checks" id="checks"></div>
    </div>
  </form>

  @include('partials/test_script')
@end
