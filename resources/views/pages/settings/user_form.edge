@component('layouts/main', { title: user ? 'แก้ไขผู้ใช้' : 'เพิ่มผู้ใช้', active: 'users' })
  <h1>{{ user ? 'แก้ไขผู้ใช้' : 'เพิ่มผู้ใช้' }}</h1>
  <p class="subtitle">
    <a href="{{ route('users.index') }}">← กลับไปรายชื่อผู้ใช้</a>
  </p>

  <form method="POST"
        action="{{ user ? route('users.update', { id: user.id }) : route('users.store') }}">
    {{ csrfField() }}

    <div class="panel">
      <div class="field">
        <label for="fullName">ชื่อ-นามสกุล</label>
        <input type="text" id="fullName" name="fullName"
               value="{{ old('fullName', user?.fullName ?? '') }}" />
      </div>

      <div class="field">
        <label for="email">อีเมล</label>
        <input type="email" id="email" name="email"
               value="{{ old('email', user?.email ?? '') }}" required autocomplete="off" />
        <p class="hint">ใช้เป็นชื่อผู้ใช้ตอนเข้าสู่ระบบ</p>
      </div>

      <div class="field">
        <label for="password">รหัสผ่าน</label>
        <input type="password" id="password" name="password"
               autocomplete="new-password"
               {{ user ? '' : 'required' }}
               placeholder="{{ user ? '••••••••  (เว้นว่าง = ไม่เปลี่ยน)' : '' }}" />
        <p class="hint">อย่างน้อย 8 ตัวอักษร</p>
      </div>

      <div class="actions">
        <button type="submit" class="primary">{{ user ? 'บันทึก' : 'เพิ่มผู้ใช้' }}</button>
        <a class="button-link secondary-link" href="{{ route('users.index') }}">ยกเลิก</a>
      </div>
    </div>
  </form>
@end
